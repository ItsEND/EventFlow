<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>EventFlow.Platform.Templates</PackageId>
    <Title>EventFlow Platform Architecture Templates</Title>
    <Authors>EventFlow</Authors>
    <Description>Opinionated .NET templates for a layered service platform with authentication, observability, Redis, Kafka, Outbox and Inbox.</Description>
    <PackageTags>dotnet-new;templates;clean-architecture;kafka;redis;opentelemetry</PackageTags>
    <Version>1.0.0</Version>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5110;NU5111;NU5128</NoWarn>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="templates\**\*"
             Exclude="templates\**\bin\**;templates\**\obj\**" />
    <Compile Remove="**\*.cs" />
    <None Update="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
