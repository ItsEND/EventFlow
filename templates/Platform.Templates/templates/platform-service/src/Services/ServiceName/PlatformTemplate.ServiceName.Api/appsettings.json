  "OTEL_RESOURCE_ATTRIBUTES": "service.namespace=PlatformTemplate,deployment.environment.name=development",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
