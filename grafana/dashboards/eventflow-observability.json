          "editorMode": "code",
          "expr": "100 * (sum(rate(http_server_request_duration_seconds_count{job=~\"$service\", http_route!=\"/metrics\", http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)) / clamp_min(sum(rate(http_server_request_duration_seconds_count{job=~\"$service\", http_route!=\"/metrics\"}[$__rate_interval])), 0.000001)",
